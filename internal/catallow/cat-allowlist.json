{
  "$comment": "openRMS raw-CAT allow-list. Normative for profile `cat` steps and for any client that sends raw CAT from a profile (openRMS-Rigs, rigctlWeb). Anything not allowed here is refused; `denied` lists are documentation and test material, and win over `families` if both match. See profile.md, 'Raw CAT allow-list'.",
  "version": "1.1.0",
  "value_pattern": "^[A-Za-z0-9]{1,16}$",
  "placeholder_pattern": "\\{value(?::(\\d+))?\\}",
  "rules": [
    "Check every command as it will be sent: the read command, the set template with each placeholder filled with zeros of its width, and the set template rendered with the step's value.",
    "A command is allowed when it matches the protocol's command_pattern, starts with a family prefix, starts with no denied prefix, and the family allows that use (read or set).",
    "ascii: the command must end with the terminator; split on it and check each non-empty part on its own.",
    "civ: the command is the CI-V body only (command, sub-command, data) as upper- or lower-case hex, without preamble, addresses or FD. Compare upper-cased.",
    "When several family prefixes match, the longest one decides read, set and safety.",
    "A family with safety 'tx' changes transmit behaviour: a step that sets it is safety tx."
  ],
  "step_rules": {
    "$comment": "Rules that bind a profile step's read, set and reply together, because ASCII CAT can't tell a read from a set by syntax. Clients that send `read` before the operator confirms (for a snapshot) must enforce these too.",
    "set": "Exactly one {value} or {value:NN} placeholder, at the end: immediately before the terminator (ascii) or last (civ). ascii: a single command.",
    "read": "Equals the set template with its placeholder removed (case-insensitive for civ hex). A step without set may have a read only when the read's family has set: false. ascii: a single command.",
    "reply": "Required with read, and only with read. Exactly '^' + read without its terminator + '(' + pattern + ')' + terminator + '$'. The pattern has no parentheses and uses only letters, digits and \\ [ ] { } , + * ? -. Capture group 1 is the value.",
    "send": "With rigctld, send a set with `send_cmd_rx <cmd> 0` (expected reply length 0). Plain send_cmd waits for a reply that a set never sends (about 2 s on the FT-DX10 backend)."
  },
  "protocols": {
    "ascii": {
      "manufacturers": ["Kenwood", "Yaesu", "Elecraft"],
      "command_pattern": "^[A-Z]{2}[A-Za-z0-9]*$",
      "allowed_chars": "^[A-Za-z0-9;]+$",
      "terminator": ";",
      "forms": { "read": "<prefix><parameters>;", "set": "<prefix><parameters><value>;" },
      "families": [
        { "prefix": "EX", "name": "menu item", "read": true, "set": true, "safety": "rx" },
        { "prefix": "MN", "name": "menu number", "read": true, "set": true, "safety": "rx" },
        { "prefix": "MP", "name": "menu parameter", "read": true, "set": true, "safety": "rx" },
        { "prefix": "MD", "name": "operating mode", "read": true, "set": true, "safety": "rx" },
        { "prefix": "DT", "name": "data mode", "read": true, "set": true, "safety": "rx" },
        { "prefix": "GT", "name": "AGC", "read": true, "set": true, "safety": "rx" },
        { "prefix": "AG", "name": "AF gain", "read": true, "set": true, "safety": "rx" },
        { "prefix": "RG", "name": "RF gain", "read": true, "set": true, "safety": "rx" },
        { "prefix": "SQ", "name": "squelch", "read": true, "set": true, "safety": "rx" },
        { "prefix": "RA", "name": "attenuator", "read": true, "set": true, "safety": "rx" },
        { "prefix": "PA", "name": "preamp", "read": true, "set": true, "safety": "rx" },
        { "prefix": "IS", "name": "IF shift", "read": true, "set": true, "safety": "rx" },
        { "prefix": "SH", "name": "filter high / shift", "read": true, "set": true, "safety": "rx" },
        { "prefix": "BW", "name": "filter width", "read": true, "set": true, "safety": "rx" },
        { "prefix": "FW", "name": "filter width", "read": true, "set": true, "safety": "rx" },
        { "prefix": "NA", "name": "narrow", "read": true, "set": true, "safety": "rx" },
        { "prefix": "NB", "name": "noise blanker", "read": true, "set": true, "safety": "rx" },
        { "prefix": "NL", "name": "noise blanker level", "read": true, "set": true, "safety": "rx" },
        { "prefix": "NR", "name": "noise reduction", "read": true, "set": true, "safety": "rx" },
        { "prefix": "BC", "name": "beat cancel / auto notch", "read": true, "set": true, "safety": "rx" },
        { "prefix": "CO", "name": "contour / APF", "read": true, "set": true, "safety": "rx" },
        { "prefix": "AN", "name": "antenna select", "read": true, "set": true, "safety": "rx" },
        { "prefix": "AP", "name": "audio peak filter", "read": true, "set": true, "safety": "rx" },
        { "prefix": "RL", "name": "noise reduction level", "read": true, "set": true, "safety": "rx" },
        { "prefix": "ML", "name": "monitor level", "read": true, "set": true, "safety": "rx" },
        { "prefix": "PC", "name": "power control", "read": true, "set": true, "safety": "tx" },
        { "prefix": "MG", "name": "mic gain", "read": true, "set": true, "safety": "tx" },
        { "prefix": "PR", "name": "speech processor", "read": true, "set": true, "safety": "tx" },
        { "prefix": "KS", "name": "keyer speed", "read": true, "set": true, "safety": "tx" },
        { "prefix": "KP", "name": "key pitch", "read": true, "set": true, "safety": "tx" },
        { "prefix": "SM", "name": "S-meter", "read": true, "set": false, "safety": "rx" },
        { "prefix": "RM", "name": "meter", "read": true, "set": false, "safety": "rx" }
      ],
      "denied": [
        { "prefix": "TX", "reason": "transmit" },
        { "prefix": "RX", "reason": "transmit/receive switching" },
        { "prefix": "MX", "reason": "MOX (transmit)" },
        { "prefix": "VX", "reason": "VOX" },
        { "prefix": "BI", "reason": "break-in" },
        { "prefix": "AC", "reason": "antenna tuner (can start a tune cycle)" },
        { "prefix": "KY", "reason": "keyer: sends CW" },
        { "prefix": "KM", "reason": "keyer memory write" },
        { "prefix": "PB", "reason": "plays a voice or keyer message" },
        { "prefix": "LM", "reason": "message recording/playback" },
        { "prefix": "MW", "reason": "memory write" },
        { "prefix": "AM", "reason": "VFO to memory write (Yaesu)" },
        { "prefix": "FA", "reason": "frequency: use rigctld, not raw CAT" },
        { "prefix": "FB", "reason": "frequency: use rigctld, not raw CAT" },
        { "prefix": "SW", "reason": "switch emulation (Elecraft)" },
        { "prefix": "TT", "reason": "text/transmit test (Elecraft)" },
        { "prefix": "ZZ", "reason": "Flex/Thetis extended set" },
        { "prefix": "PS", "reason": "power on/off" }
      ]
    },
    "civ": {
      "manufacturers": ["Icom"],
      "command_pattern": "^([0-9A-F]{2})+$",
      "forms": { "read": "<command><sub-command>", "set": "<command><sub-command><data>" },
      "families": [
        { "prefix": "04", "name": "read operating mode", "read": true, "set": false, "safety": "rx" },
        { "prefix": "06", "name": "set operating mode", "read": false, "set": true, "safety": "rx" },
        { "prefix": "11", "name": "attenuator", "read": true, "set": true, "safety": "rx" },
        { "prefix": "14", "name": "levels (gains, NR/NB levels, power, mic gain)", "read": true, "set": true, "safety": "rx" },
        { "prefix": "1409", "name": "CW pitch", "read": true, "set": true, "safety": "tx" },
        { "prefix": "140A", "name": "RF power", "read": true, "set": true, "safety": "tx" },
        { "prefix": "140B", "name": "mic gain", "read": true, "set": true, "safety": "tx" },
        { "prefix": "140C", "name": "keyer speed", "read": true, "set": true, "safety": "tx" },
        { "prefix": "140E", "name": "compressor level", "read": true, "set": true, "safety": "tx" },
        { "prefix": "140F", "name": "break-in delay", "read": true, "set": true, "safety": "tx" },
        { "prefix": "1416", "name": "VOX gain", "read": true, "set": true, "safety": "tx" },
        { "prefix": "1417", "name": "anti-VOX", "read": true, "set": true, "safety": "tx" },
        { "prefix": "15", "name": "meters", "read": true, "set": false, "safety": "rx" },
        { "prefix": "16", "name": "functions (preamp, AGC, NB, NR, notch...)", "read": true, "set": true, "safety": "rx" },
        { "prefix": "1644", "name": "speech compressor", "read": true, "set": true, "safety": "tx" },
        { "prefix": "1A", "name": "settings (filter width, AGC time, menu items, data mode)", "read": true, "set": true, "safety": "rx" }
      ],
      "denied": [
        { "prefix": "1646", "reason": "VOX" },
        { "prefix": "1647", "reason": "break-in" },
        { "prefix": "1A00", "reason": "memory contents write" },
        { "prefix": "1A01", "reason": "band stacking register write" },
        { "prefix": "1A02", "reason": "memory keyer contents" },
        { "prefix": "1C", "reason": "transmit / antenna tuner" },
        { "prefix": "17", "reason": "sends CW" },
        { "prefix": "28", "reason": "plays a voice message" },
        { "prefix": "05", "reason": "frequency: use rigctld, not raw CAT" },
        { "prefix": "18", "reason": "power on/off" },
        { "prefix": "08", "reason": "memory mode" },
        { "prefix": "09", "reason": "memory write" },
        { "prefix": "0B", "reason": "memory clear" }
      ]
    }
  }
}
