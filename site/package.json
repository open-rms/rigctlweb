{
  "name": "rigctlweb-site",
  "version": "0.1.0",
  "description": "rigctlweb.openrms.dev: rigctlWeb landing page, downloads and docs",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "cf:dev": "pnpm build && wrangler dev",
    "cf:deploy": "pnpm build && wrangler deploy"
  },
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.23.0",
  "type": "module",
  "devDependencies": {
    "@lucide/svelte": "^1.80.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "bits-ui": "^2.22.0",
    "clsx": "^2.1.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "wrangler": "^4",
    "marked": "^18.2.1"
  },
  "private": true,
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  }
}
